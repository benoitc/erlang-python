%% Node-wide settings for the Common Test run.
%%
%% Memory limits hook the obmalloc arena allocator before Python starts, so the
%% flag has to be set for whichever suite initialises the runtime first;
%% py_memory_limit_SUITE cannot turn it on by itself mid-run.
[
    {erlang_python, [
        {enable_memory_limits, true}
    ]}
].
